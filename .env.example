# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Writing analysis (Google Gemini) — optional; mock fallback exists
GOOGLE_AI_API_KEY=

# Speaking live — local Ollama by default (no API key required)
SPEAKING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SPEAKING_MODEL=gemma4:e4b

# Optional cloud speaking providers (set SPEAKING_PROVIDER to openai|gemini)
# OPENAI_API_KEY=
# OPENAI_SPEAKING_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_SPEAKING_MODEL=gemini-2.0-flash

# Local TTS (Piper male en_US-ryan-low by default — no API key)
TTS_PROVIDER=piper
TTS_PIPER_MODEL=models/tts/en_US-ryan-low.onnx
# TTS_PIPER_BIN=/Users/YOU/Library/Python/3.11/bin/piper
# Other Piper voices:
# TTS_PIPER_MODEL=models/tts/en_US-danny-low.onnx   # male alt
# TTS_PIPER_MODEL=models/tts/en_US-lessac-low.onnx  # female
# Fallback without Piper on macOS:
# TTS_PROVIDER=macos
# TTS_MACOS_VOICE=Eddy
# Optional cloud TTS later:
# TTS_PROVIDER=openai
# TTS_OPENAI_MODEL=gpt-4o-mini-tts
# TTS_OPENAI_VOICE=alloy
